# Telegram Bot Token
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Coinbase Developer Platform (CDP) Credentials
# Create at: https://portal.cdp.coinbase.com
CDP_API_KEY_NAME=your_cdp_api_key_name
CDP_PRIVATE_KEY=your_cdp_private_key_pem

# Wallet Encryption Key (32 bytes in hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=your_64_char_hex_string_here

# Network Configuration
# Options: base-mainnet, base-sepolia, ethereum-mainnet
NETWORK_ID=base-sepolia

# Data Directory (optional)
# Where to store the SQLite database
DATA_DIR=./data